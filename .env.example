# Supabase Configuration
# Obtén estas credenciales en https://app.supabase.com → Settings → API

SUPABASE_URL=https://your_project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here

# Para desarrollo local sin Supabase, puedes dejar estos vacíos
# La aplicación funcionará correctamente solo con AsyncStorage
